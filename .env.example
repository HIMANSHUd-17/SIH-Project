# SafeYatra Tourist Safety Platform - Environment Variables Template
# Copy this file to .env and configure your secrets

# Node / Express Server Port
PORT=5009

# FastAPI Microservice URL
FASTAPI_URL=http://localhost:8000

# Admin Portal Credentials
ADMIN_USERNAME=admin@gmail.com
ADMIN_PASSWORD=change_this_admin_password_in_production

# JWT Authentication Secret Key (Used by FastAPI)
JWT_SECRET_KEY=change_this_jwt_secret_key_in_production

# Google Gemini API Key (Multilingual Safety AI Voice, Agent & Chat Assistant)
# Obtain your key securely from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# IPFS Pinata Service Credentials (Optional for Incident Evidence Pinning)
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_key_here

# Web3 / Blockchain Network Configuration (Localhost / Polygon)
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=your_admin_wallet_private_key_here
CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3
